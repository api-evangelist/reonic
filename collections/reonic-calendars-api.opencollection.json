{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reonic REST Api v3 Activities Calendars API",
    "version": "3.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Authorization",
      "value": "{{X-Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Calendars",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List calendars",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{apiBaseUrl}/rest/v3/calendars",
            "headers": [
              {
                "name": "Reonic-Cache-Control",
                "value": ""
              }
            ]
          },
          "docs": "List all Reonic Calendars.\n\n**Allowed API keys:** Read-only, Read and Write"
        }
      ]
    }
  ],
  "bundled": true
}