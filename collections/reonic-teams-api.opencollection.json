{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reonic REST Api v3 Activities Teams API",
    "version": "3.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Authorization",
      "value": "{{X-Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{apiBaseUrl}/rest/v3/teams",
            "headers": [
              {
                "name": "Reonic-Cache-Control",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "parentId",
                "value": "",
                "type": "query",
                "description": "Only return direct children of this team. Mutually exclusive with `ancestorId`."
              },
              {
                "name": "ancestorId",
                "value": "",
                "type": "query",
                "description": "Returns all descendants of this team, not just direct children. Mutually exclusive with `parentId`."
              },
              {
                "name": "memberIds",
                "value": "",
                "type": "query",
                "description": "Filter teams that include any of the specified user IDs as either team members or team leaders."
              },
              {
                "name": "archived",
                "value": "",
                "type": "query",
                "description": "Controls whether archived teams appear in results. Default: exclude."
              }
            ]
          },
          "docs": "Lists teams. Use `parentId` for direct children or `ancestorId` for all descendants.\n\n**Allowed API keys:** Read-only, Read and Write"
        },
        {
          "info": {
            "name": "Get team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{apiBaseUrl}/rest/v3/teams/:teamId",
            "headers": [
              {
                "name": "Reonic-Cache-Control",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single team by its ID.\n\n**Allowed API keys:** Read-only, Read and Write"
        },
        {
          "info": {
            "name": "Create team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{apiBaseUrl}/rest/v3/teams/create",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new team.\n\n**Allowed API keys:** Read and Write"
        },
        {
          "info": {
            "name": "Update team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{apiBaseUrl}/rest/v3/teams/:teamId/update",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a team by its ID.\n\n**Allowed API keys:** Read and Write"
        }
      ]
    }
  ],
  "bundled": true
}