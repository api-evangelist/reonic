      "id": "e7a01506-93a9-4bdd-a06e-7ef83d6d6024",
      "name": "Appointments",
      "description": {
        "content": "Appointments on Reonic-hosted calendars only. External calendars (Google, Microsoft) cannot be read or written through the API.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "90efba6a-f1b3-4418-adfb-79d338b757e7",
          "name": "List appointments",
          "request": {
            "name": "List appointments",
            "description": {
              "content": "Lists appointments on Reonic calendars in a paginated format.\n\n**Allowed API keys:** Read-only, Read and Write",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "appointments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "calendarIds",
                  "value": "<uuid>",
                  "description": "Comma-separated list or repeated query param of calendar IDs to fetch appointments for."
                },
                {
                  "disabled": false,
                  "key": "residentialProjectId",
                  "value": "<uuid>",
                  "description": "Return only appointments linked to the given residential project. Mutually exclusive with `commercialProjectId`. Reference to [**Residential Projects**](#tag/residential-projects)"
                },
                {
                  "disabled": false,
                  "key": "commercialProjectId",
                  "value": "<uuid>",
                  "description": "Return only appointments linked to the given commercial project. Mutually exclusive with `residentialProjectId`. Reference to [**Commercial Projects**](#tag/commercial-projects)"
                },
                {
                  "disabled": false,
                  "key": "start.gt",
                  "value": "<string,null-date-time>",
                  "description": "Filter records where start is after this datetime (exclusive)"
                },
                {
                  "disabled": false,
                  "key": "start.lt",
                  "value": "<string,null-date-time>",
                  "description": "Defaults to the day one year from now."
                },
                {
                  "disabled": false,
                  "key": "end.gt",
                  "value": "<string,null-date-time>",
                  "description": "Defaults to now, so that by default only upcoming appointments are returned."
                },
                {
                  "disabled": false,
                  "key": "end.lt",
                  "value": "<string,null-date-time>",
                  "description": "Filter records where end is before this datetime (exclusive)"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number, starting from 1. Default: 1."
                },
                {
                  "disabled": false,
                  "key": "itemsPerPage",
                  "value": "50",
                  "description": "Number of items per page. Default: 50. Max: 200."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "start",
                  "description": "Sort order. Use field names for ascending (e.g. \"createdAt\"), minus sign for descending (e.g. \"-createdAt\"). Chain with commas (e.g. \"createdAt,editedAt\"). Sortable fields: start, end. Defaults to start."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
