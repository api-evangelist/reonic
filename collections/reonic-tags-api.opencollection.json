{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reonic REST Api v3 Activities Tags API",
    "version": "3.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Authorization",
      "value": "{{X-Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{apiBaseUrl}/rest/v3/tags",
            "headers": [
              {
                "name": "Reonic-Cache-Control",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "parentType",
                "value": "",
                "type": "query",
                "description": "Type of entity the tag can be applied to."
              },
              {
                "name": "archived",
                "value": "",
                "type": "query",
                "description": "Controls whether archived tags appear in results. Default: exclude."
              }
            ]
          },
          "docs": "List all tags.\n\n**Allowed API keys:** Read-only, Read and Write"
        },
        {
          "info": {
            "name": "Get tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{apiBaseUrl}/rest/v3/tags/:tagId",
            "headers": [
              {
                "name": "Reonic-Cache-Control",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single tag by its ID.\n\n**Allowed API keys:** Read-only, Read and Write"
        },
        {
          "info": {
            "name": "Create tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{apiBaseUrl}/rest/v3/tags/create",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new tag\n\n**Allowed API keys:** Read and Write"
        },
        {
          "info": {
            "name": "Update tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{apiBaseUrl}/rest/v3/tags/:tagId/update",
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a tag by its ID.\n\n**Allowed API keys:** Read and Write"
        }
      ]
    }
  ],
  "bundled": true
}